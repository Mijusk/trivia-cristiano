  {"id": "dibujar-73", "tema": "pentateuco", "nivel": "experta", "tipo": "escena", "adivinar": "El agua de la roca", "claves": ["agua", "roca"], "escena": "Un hombre golpea una roca con su bastón y sale un chorro de agua", "pista": "Lo hizo Moisés en el desierto", "referencia": "Núm 20,11"},
  {"id": "dibujar-74", "tema": "pentateuco", "nivel": "experta", "tipo": "objeto", "adivinar": "La vara de Aarón", "claves": ["vara", "Aarón"], "escena": "Un bastón del que salen flores y almendras", "pista": "Floreció en una sola noche", "referencia": "Núm 17,23"},
  {"id": "dibujar-75", "tema": "historicos", "nivel": "peques", "tipo": "objeto", "adivinar": "La honda de David", "claves": ["honda"], "escena": "Una honda con una piedra", "pista": "Con ella venció a un gigante", "referencia": "1 Sam 17,40"},
  {"id": "dibujar-76", "tema": "historicos", "nivel": "peques", "tipo": "objeto", "adivinar": "La espada", "claves": ["espada"], "escena": "Una espada grande y brillante", "pista": "La de Goliat era enorme", "referencia": "1 Sam 17,51"},
  {"id": "dibujar-77", "tema": "historicos", "nivel": "peques", "tipo": "animal", "adivinar": "El perro de Tobías", "claves": ["perro"], "escena": "Un perro siguiendo a su dueño por el camino", "pista": "Acompañó a Tobías en su viaje", "referencia": "Tob 6,2"},
  {"id": "dibujar-78", "tema": "historicos", "nivel": "peques", "tipo": "objeto", "adivinar": "Las murallas", "claves": ["murallas"], "escena": "Unas murallas de piedra derrumbándose", "pista": "Las de Jericó se cayeron", "referencia": "Jos 6,20"},
  {"id": "dibujar-79", "tema": "historicos", "nivel": "peques", "tipo": "escena", "adivinar": "El pelo de Sansón", "claves": ["pelo"], "escena": "Un hombre muy fuerte con el pelo larguísimo", "pista": "Ahí estaba su fuerza", "referencia": "Jue 16,17"},
  {"id": "dibujar-80", "tema": "historicos", "nivel": "media", "tipo": "escena", "adivinar": "Samuel dormido en el templo", "claves": ["Samuel"], "escena": "Un niño en la cama oyendo una voz en la noche", "pista": "Dios lo llamó tres veces", "referencia": "1 Sam 3,3-10"},
  {"id": "dibujar-81", "tema": "historicos", "nivel": "media", "tipo": "escena", "adivinar": "Elías y los cuervos", "claves": ["Elías", "cuervos"], "escena": "Un hombre junto a un arroyo y pájaros negros que le traen pan", "pista": "Es un profeta", "referencia": "1 Re 17,5-6"},
  {"id": "dibujar-82", "tema": "historicos", "nivel": "media", "tipo": "escena", "adivinar": "Dalila cortando el pelo a Sansón", "claves": ["Dalila", "Sansón"], "escena": "Una mujer con tijeras y un hombre dormido", "pista": "Así perdió su fuerza", "referencia": "Jue 16,19"},
  {"id": "dibujar-83", "tema": "historicos", "nivel": "media", "tipo": "escena", "adivinar": "La reina de Sabá", "claves": ["reina", "Sabá"], "escena": "Una reina con camellos cargados de regalos ante un rey", "pista": "Visitó a un rey muy sabio", "referencia": "1 Re 10,1-2"},
  {"id": "dibujar-84", "tema": "historicos", "nivel": "media", "tipo": "escena", "adivinar": "Naamán en el río", "claves": ["Naamán", "río"], "escena": "Un hombre bañándose en un río, contando hasta siete", "pista": "Se curó de la lepra", "referencia": "2 Re 5,14"},
  {"id": "dibujar-85", "tema": "historicos", "nivel": "experta", "tipo": "escena", "adivinar": "El ángel Rafael", "claves": ["Rafael"], "escena": "Un ángel caminando junto a un joven y un perro", "pista": "Acompañó a Tobías", "referencia": "Tob 5,4-17"},
  {"id": "dibujar-86", "tema": "historicos", "nivel": "experta", "tipo": "escena", "adivinar": "Los soldados de Gedeón", "claves": ["Gedeón", "soldados"], "escena": "Soldados bebiendo agua del río con la mano, como perros", "pista": "Solo eligió a trescientos", "referencia": "Jue 7,5-7"},
  {"id": "dibujar-87", "tema": "historicos", "nivel": "experta", "tipo": "escena", "adivinar": "Absalón colgado del árbol", "claves": ["Absalón", "árbol"], "escena": "Un hombre colgado de una rama y una mula que se va", "pista": "Era hijo de David", "referencia": "2 Sam 18,9"},
  {"id": "dibujar-88", "tema": "historicos", "nivel": "experta", "tipo": "escena", "adivinar": "La muralla de Jerusalén", "claves": ["muralla", "Jerusalén"], "escena": "Obreros levantando una muralla con la espada en el cinturón", "pista": "La reconstruyó Nehemías", "referencia": "Neh 4,11-12"},
  {"id": "dibujar-89", "tema": "historicos", "nivel": "experta", "tipo": "escena", "adivinar": "Elías bajo la retama", "claves": ["Elías"], "escena": "Un hombre dormido bajo un arbusto y un ángel con pan y agua", "pista": "Estaba muy cansado y quería rendirse", "referencia": "1 Re 19,4-8"},
  {"id": "dibujar-90", "tema": "profetas", "nivel": "peques", "tipo": "objeto", "adivinar": "El barco", "claves": ["barco"], "escena": "Un barco en medio de una tormenta", "pista": "Jonás huyó en uno", "referencia": "Jon 1,3-4"},
  {"id": "dibujar-91", "tema": "profetas", "nivel": "peques", "tipo": "objeto", "adivinar": "El tambor", "claves": ["tambor"], "escena": "Un tambor con sus palillos", "pista": "Con él se alaba a Dios en el último salmo", "referencia": "Sal 150,4"},
  {"id": "dibujar-92", "tema": "profetas", "nivel": "peques", "tipo": "animal", "adivinar": "El cordero", "claves": ["cordero"], "escena": "Un corderito blanco", "pista": "Isaías compara al Mesías con él", "referencia": "Is 53,7"},
  {"id": "dibujar-93", "tema": "profetas", "nivel": "peques", "tipo": "objeto", "adivinar": "El árbol", "claves": ["árbol"], "escena": "Un árbol con frutas junto a un río", "pista": "El justo es como uno de ellos", "referencia": "Sal 1,3"},
  {"id": "dibujar-94", "tema": "profetas", "nivel": "peques", "tipo": "objeto", "adivinar": "El trono", "claves": ["trono"], "escena": "Una silla de rey muy grande", "pista": "Isaías vio a Dios sentado en uno", "referencia": "Is 6,1"},
  {"id": "dibujar-95", "tema": "profetas", "nivel": "media", "tipo": "escena", "adivinar": "Daniel rezando en la ventana", "claves": ["Daniel", "ventana"], "escena": "Un hombre de rodillas junto a una ventana abierta", "pista": "Lo hacía tres veces al día", "referencia": "Dan 6,11"},
  {"id": "dibujar-96", "tema": "profetas", "nivel": "media", "tipo": "escena", "adivinar": "Jonás en el barco", "claves": ["Jonás", "barco"], "escena": "Un hombre durmiendo en un barco mientras hay una gran tormenta", "pista": "Huía de Dios", "referencia": "Jon 1,4-5"},
  {"id": "dibujar-97", "tema": "profetas", "nivel": "media", "tipo": "escena", "adivinar": "Susana en el jardín", "claves": ["Susana", "jardín"], "escena": "Una mujer en un jardín y dos ancianos espiando detrás de un árbol", "pista": "Daniel demostró que era inocente", "referencia": "Dan 13,15-20"},
  {"id": "dibujar-98", "tema": "profetas", "nivel": "media", "tipo": "escena", "adivinar": "Job y sus amigos", "claves": ["Job", "amigos"], "escena": "Un hombre triste en el suelo y tres amigos sentados a su lado", "pista": "Estuvieron siete días sin hablar", "referencia": "Job 2,11-13"},
  {"id": "dibujar-99", "tema": "profetas", "nivel": "media", "tipo": "escena", "adivinar": "Isaías y la brasa", "claves": ["Isaías", "brasa"], "escena": "Un ángel con alas tocando los labios de un hombre con una brasa", "pista": "Un serafín lo purificó", "referencia": "Is 6,6-7"},
  {"id": "dibujar-100", "tema": "profetas", "nivel": "experta", "tipo": "escena", "adivinar": "Las huellas en la ceniza", "claves": ["huellas", "ceniza"], "escena": "Un suelo lleno de huellas de pies junto a una estatua y una mesa vacía", "pista": "Así descubrió Daniel el engaño del ídolo Bel", "referencia": "Dan 14,1-22"},
  {"id": "dibujar-101", "tema": "profetas", "nivel": "experta", "tipo": "escena", "adivinar": "Ezequiel comiendo el rollo", "claves": ["Ezequiel", "rollo"], "escena": "Un hombre comiéndose un pergamino enrollado con cara de gusto", "pista": "Le supo dulce como la miel", "referencia": "Ez 3,1-3"},
  {"id": "dibujar-102", "tema": "profetas", "nivel": "experta", "tipo": "escena", "adivinar": "La viña del Señor", "claves": ["viña"], "escena": "Un campo de uvas con una torre y una cerca", "pista": "Isaías le dedicó una canción", "referencia": "Is 5,1-2"},
  {"id": "dibujar-103", "tema": "profetas", "nivel": "experta", "tipo": "escena", "adivinar": "Las ruedas de Ezequiel", "claves": ["ruedas", "Ezequiel"], "escena": "Una rueda dentro de otra rueda, con alas y ojos", "pista": "Fue una visión muy extraña", "referencia": "Ez 1,15-18"},
  {"id": "dibujar-104", "tema": "profetas", "nivel": "experta", "tipo": "escena", "adivinar": "Jeremías en el pozo", "claves": ["Jeremías", "pozo"], "escena": "Un hombre hundido en el barro dentro de un pozo y una cuerda bajando", "pista": "Lo sacaron con trapos viejos y cuerdas", "referencia": "Jer 38,6-13"},
  {"id": "dibujar-105", "tema": "nt", "nivel": "peques", "tipo": "animal", "adivinar": "El burro de Ramos", "claves": ["burro"], "escena": "Un burro y gente con hojas de palmera", "pista": "Jesús entró montado en él en Jerusalén", "referencia": "Mc 11,7-8"},
  {"id": "dibujar-106", "tema": "nt", "nivel": "peques", "tipo": "objeto", "adivinar": "La cruz", "claves": ["cruz"], "escena": "Una cruz de madera en un monte", "pista": "Jesús murió en ella", "referencia": "Jn 19,17-18"},
  {"id": "dibujar-107", "tema": "nt", "nivel": "peques", "tipo": "escena", "adivinar": "Los Reyes Magos", "claves": ["Magos"], "escena": "Tres reyes con coronas, camellos y regalos", "pista": "Siguieron una estrella", "referencia": "Mt 2,1-11"},
  {"id": "dibujar-108", "tema": "nt", "nivel": "peques", "tipo": "escena", "adivinar": "El ángel y María", "claves": ["ángel", "María"], "escena": "Un ángel con alas hablando con una joven", "pista": "El ángel se llamaba Gabriel", "referencia": "Lc 1,26-38"},
  {"id": "dibujar-109", "tema": "nt", "nivel": "peques", "tipo": "objeto", "adivinar": "La red llena de peces", "claves": ["red", "peces"], "escena": "Una red de pescar a rebosar de peces", "pista": "Pedro casi no podía sacarla", "referencia": "Lc 5,4-6"},
  {"id": "dibujar-110", "tema": "nt", "nivel": "media", "tipo": "escena", "adivinar": "El bautismo de Jesús", "claves": ["bautismo"], "escena": "Jesús en un río y una paloma bajando del cielo", "pista": "Lo bautizó Juan", "referencia": "Mc 1,9-11"},
  {"id": "dibujar-111", "tema": "nt", "nivel": "media", "tipo": "escena", "adivinar": "La Última Cena", "claves": ["Cena"], "escena": "Jesús y doce amigos en una mesa larga con pan y vino", "pista": "Fue el Jueves Santo", "referencia": "Lc 22,14-20"},
  {"id": "dibujar-112", "tema": "nt", "nivel": "media", "tipo": "escena", "adivinar": "Lázaro saliendo de la tumba", "claves": ["Lázaro"], "escena": "Un hombre envuelto en vendas saliendo de una cueva", "pista": "Jesús lo resucitó", "referencia": "Jn 11,43-44"},
  {"id": "dibujar-113", "tema": "nt", "nivel": "media", "tipo": "escena", "adivinar": "El hijo pródigo con los cerdos", "claves": ["pródigo", "cerdos"], "escena": "Un joven triste y hambriento rodeado de cerdos", "pista": "Es una parábola", "referencia": "Lc 15,15-17"},
  {"id": "dibujar-114", "tema": "nt", "nivel": "media", "tipo": "escena", "adivinar": "Jesús y los niños", "claves": ["Jesús", "niños"], "escena": "Jesús sentado y muchos niños a su alrededor", "pista": "«Dejad que los niños se acerquen a mí»", "referencia": "Mc 10,13-16"},
  {"id": "dibujar-115", "tema": "nt", "nivel": "experta", "tipo": "escena", "adivinar": "Saulo y la luz", "claves": ["Saulo", "luz"], "escena": "Un hombre caído en el camino y una luz enorme desde el cielo", "pista": "Iba camino de Damasco", "referencia": "Hch 9,3-4"},
  {"id": "dibujar-116", "tema": "nt", "nivel": "experta", "tipo": "escena", "adivinar": "La moneda perdida", "claves": ["moneda"], "escena": "Una mujer barriendo la casa con una lámpara, buscando algo", "pista": "Es una parábola", "referencia": "Lc 15,8-9"},
  {"id": "dibujar-117", "tema": "nt", "nivel": "experta", "tipo": "escena", "adivinar": "El sembrador", "claves": ["sembrador"], "escena": "Un hombre echando semillas: unas caen en el camino, otras en piedras y otras en buena tierra", "pista": "Es una parábola", "referencia": "Mt 13,3-8"},
  {"id": "dibujar-118", "tema": "nt", "nivel": "experta", "tipo": "escena", "adivinar": "Las diez vírgenes", "claves": ["vírgenes"], "escena": "Diez jóvenes con lámparas: cinco encendidas y cinco apagadas", "pista": "Es una parábola", "referencia": "Mt 25,1-4"},
  {"id": "dibujar-119", "tema": "nt", "nivel": "experta", "tipo": "escena", "adivinar": "El pez con la moneda", "claves": ["pez", "moneda"], "escena": "Un pez con una moneda en la boca", "pista": "Pedro pagó así un impuesto", "referencia": "Mt 17,27"},
  {"id": "dibujar-120", "tema": "vida", "nivel": "peques", "tipo": "objeto", "adivinar": "El cáliz", "claves": ["cáliz"], "escena": "Una copa grande y dorada encima del altar", "pista": "En misa, el sacerdote pone en ella el vino"},
  {"id": "dibujar-121", "tema": "vida", "nivel": "peques", "tipo": "objeto", "adivinar": "La campana de la iglesia", "claves": ["campana"], "escena": "Una campana colgada en lo alto de la torre de una iglesia", "pista": "Suena para llamar a misa"},
  {"id": "dibujar-122", "tema": "vida", "nivel": "peques", "tipo": "objeto", "adivinar": "La vela", "claves": ["vela"], "escena": "Una vela encendida con su llamita encima del altar", "pista": "Da luz y se enciende en misa"},
  {"id": "dibujar-123", "tema": "vida", "nivel": "peques", "tipo": "objeto", "adivinar": "La hostia", "claves": ["hostia"], "escena": "Un círculo blanco con una cruz dibujada encima", "pista": "Se recibe en la comunión"},
  {"id": "dibujar-124", "tema": "vida", "nivel": "peques", "tipo": "objeto", "adivinar": "El rosario", "claves": ["rosario"], "escena": "Un collar de bolitas con una cruz colgando", "pista": "Se reza pasando las cuentas con los dedos"},
  {"id": "dibujar-125", "tema": "vida", "nivel": "peques", "tipo": "personaje", "adivinar": "El Papa", "claves": ["Papa"], "escena": "Un señor vestido de blanco, con un gorrito blanco y una cruz en el pecho", "pista": "Vive en el Vaticano"},
  {"id": "dibujar-126", "tema": "vida", "nivel": "peques", "tipo": "objeto", "adivinar": "La iglesia", "claves": ["iglesia"], "escena": "Un edificio con una torre, una puerta grande y una cruz en lo alto", "pista": "Allí vamos a misa los domingos"},
  {"id": "dibujar-127", "tema": "vida", "nivel": "peques", "tipo": "personaje", "adivinar": "El ángel de la guarda", "claves": ["ángel"], "escena": "Un ángel con alas que lleva de la mano a un niño", "pista": "Nos cuida siempre"},
  {"id": "dibujar-128", "tema": "vida", "nivel": "peques", "tipo": "objeto", "adivinar": "La corona de Adviento", "claves": ["corona"], "escena": "Un círculo de ramas verdes con cuatro velas", "pista": "Se enciende una vela cada domingo antes de Navidad"},
  {"id": "dibujar-129", "tema": "vida", "nivel": "peques", "tipo": "objeto", "adivinar": "El agua bendita", "claves": ["agua"], "escena": "Una pila de piedra a la entrada de la iglesia y una mano mojando los dedos", "pista": "Nos santiguamos con ella al entrar"},
  {"id": "dibujar-130", "tema": "vida", "nivel": "media", "tipo": "escena", "adivinar": "La primera comunión", "claves": ["comunión"], "escena": "Un niño vestido de fiesta, con las manos juntas, recibiendo la hostia", "pista": "Suele ser hacia los nueve años"},
  {"id": "dibujar-131", "tema": "vida", "nivel": "media", "tipo": "escena", "adivinar": "La boda", "claves": ["boda"], "escena": "Unos novios delante del altar poniéndose los anillos", "pista": "Es el sacramento del Matrimonio"},
  {"id": "dibujar-132", "tema": "vida", "nivel": "media", "tipo": "escena", "adivinar": "El bautizo", "claves": ["bautizo"], "escena": "Un sacerdote echando agua en la cabeza de un bebé sobre una pila", "pista": "Es el primer sacramento"},
  {"id": "dibujar-133", "tema": "vida", "nivel": "media", "tipo": "objeto", "adivinar": "El sagrario", "claves": ["sagrario"], "escena": "Una cajita dorada con puerta y, al lado, una lámpara roja encendida", "pista": "Allí se guarda la Eucaristía"},
  {"id": "dibujar-134", "tema": "vida", "nivel": "media", "tipo": "objeto", "adivinar": "La custodia", "claves": ["custodia"], "escena": "Un sol dorado con rayos y una hostia blanca en el centro", "pista": "Se saca en la procesión del Corpus"},
  {"id": "dibujar-135", "tema": "vida", "nivel": "media", "tipo": "escena", "adivinar": "La procesión", "claves": ["procesión"], "escena": "Gente con velas caminando por la calle detrás de una imagen llevada a hombros", "pista": "Se ven muchas en Semana Santa"},
  {"id": "dibujar-136", "tema": "vida", "nivel": "media", "tipo": "objeto", "adivinar": "El cirio pascual", "claves": ["cirio"], "escena": "Una vela muy alta y gruesa con una cruz pintada y cinco granos de incienso clavados", "pista": "Se enciende en la Vigilia Pascual"},
  {"id": "dibujar-137", "tema": "vida", "nivel": "media", "tipo": "objeto", "adivinar": "El confesionario", "claves": ["confesionario"], "escena": "Una cabina de madera con una rejilla, un sacerdote dentro y una persona arrodillada fuera", "pista": "Allí se celebra el sacramento del perdón"},
  {"id": "dibujar-138", "tema": "vida", "nivel": "media", "tipo": "escena", "adivinar": "San Francisco con los animales", "claves": ["Francisco", "animales"], "escena": "Un fraile con hábito marrón y cuerda en la cintura, rodeado de pájaros y con un lobo a sus pies", "pista": "Es un santo de Asís"},
  {"id": "dibujar-139", "tema": "vida", "nivel": "media", "tipo": "escena", "adivinar": "El Miércoles de Ceniza", "claves": ["Ceniza"], "escena": "Un sacerdote marcando una cruz gris en la frente de una persona", "pista": "Ese día empieza la Cuaresma", "referencia": "Gén 3,19"},
  {"id": "dibujar-140", "tema": "vida", "nivel": "experta", "tipo": "escena", "adivinar": "La Vigilia Pascual", "claves": ["Vigilia"], "escena": "Una hoguera en la puerta de una iglesia a oscuras y un sacerdote encendiendo con ella una vela enorme", "pista": "La noche más importante del año"},
  {"id": "dibujar-141", "tema": "vida", "nivel": "experta", "tipo": "escena", "adivinar": "La Santísima Trinidad", "claves": ["Trinidad"], "escena": "Un trébol de tres hojas que forman una sola planta", "pista": "Un solo Dios en tres Personas", "referencia": "Mt 28,19"},
  {"id": "dibujar-142", "tema": "vida", "nivel": "experta", "tipo": "escena", "adivinar": "San Martín partiendo la capa", "claves": ["Martín", "capa"], "escena": "Un soldado a caballo corta su capa con la espada y le da la mitad a un pobre", "pista": "Era un soldado romano que se hizo santo"},
